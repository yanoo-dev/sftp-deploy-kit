# .vscode/sftp.json 이 있으면 그게 우선 적용됩니다 (config.js 기준).
# 이 파일은 .vscode/sftp.json 이 없을 때만 쓰이는 폴백입니다.
# sftp.json이 있어도 무시하고 이 .env를 강제로 쓰려면 1 (기본: 비워두면 sftp.json 있을 때 그게 우선)
# — 재택 등 SSH 터널 경유 접속처럼, sftp.json과 다른 접속 경로가 필요할 때 씀
SFTP_FORCE_ENV=
# sftp 또는 ftp (생략 시 기본값 sftp)
SFTP_PROTOCOL=sftp
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=
SFTP_PRIVATE_KEY=
SFTP_PASSPHRASE=
SFTP_REMOTE_ROOT=
# 로컬 소스 폴더명 (생략 시 기본값 web)
SFTP_LOCAL_ROOT=
