{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -f .vscode/sftp.json && node scripts/sftp-auto.js off >/dev/null 2>&1 || true",
            "timeout": 15,
            "statusMessage": "SFTP downloadOnOpen 끄는 중 (AI 세션 충돌 방지)"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -f .vscode/sftp.json && node scripts/sftp-auto.js on >/dev/null 2>&1 || true",
            "timeout": 15,
            "statusMessage": "SFTP downloadOnOpen 복구 중"
          }
        ]
      }
    ]
  }
}
